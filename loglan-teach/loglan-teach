# Loglan flashcard drill in the MacTeach mold.
# Reads tab-separated data files (PRIMS / AFFS / AFFSETS: <loglan>\t<affix>\t
# <gloss>\t<notes>; UTTS or any other: <loglan>\t<answer>) and drills them
# with a ladder + error-box spaced-repetition system.  If a 'derivs' table
# sits beside the data file, each answer is followed by where the word came
# from (see mk-utility).

my %opt = (
    rungs  => 5,
    escape => 2,
    field  => 'gloss',
    dir    => 'recognition',
);

GetOptions(
    \%opt,
    'recall'     => sub { $opt{dir} = 'recall' },
    'recognition'=> sub { $opt{dir} = 'recognition' },
    'both'       => sub { $opt{dir} = 'both' },
    'rungs=i',
    'escape=i',
    'field=s',
    'state=s',
    'derivs=s',
    'no-derivs' => sub { $opt{noderivs} = 1 },
    'lessons=s',
    'random',
    'reset',
    'no-sync'    => sub { $opt{nosync} = 1 },
    'status',
    'tables',
    'help|h',
) or die "Try --help\n";

# Nothing the user types is matched case-sensitively, option values included.
$opt{field} = lc $opt{field};

usage() if $opt{help} or (!@ARGV and !$opt{tables});

# Where the lists and progress are kept: LOGLAN_STATE_DIR, else ~/.loglan,
# which is where loglan-update puts the lists.  Every table's
# state is collected there under the data file's own name, so drilling a list
# from anywhere still leaves its progress in the one place.  Without such a
# directory the state file sits beside the data file.  --state always wins.
my $state_dir = $ENV{LOGLAN_STATE_DIR} // "$ENV{HOME}/.loglan";
undef $state_dir unless -d $state_dir;

if (defined $state_dir) {
    show_update_note($state_dir);
    start_update($state_dir);
}

show_tables($state_dir), exit 0 if $opt{tables};

# Is the list directory a Subversion working copy whose files go with you
# from one machine to the next (see sync_in)?
my $svn_dir = !$opt{nosync} && !$ENV{LOGLAN_NO_SYNC} && defined $state_dir && -d "$state_dir/.svn";

# A bare list name -- "prims", "animals" -- is one of the lists there (or
# among the auxiliary lists, in aux/), unless a file by that name is right
# here.  A list of one's own committed from another machine, and not here
# yet, is fetched from the repository first.
my $data_file = shift @ARGV;
if (!-e $data_file && defined $state_dir && $data_file !~ m{/}) {
    my $name = $data_file;
    svn('update', '-q', "$state_dir/$name")
        if $svn_dir && !grep { -f } "$state_dir/$name", "$state_dir/aux/$name";
    ($data_file) = grep { -f } "$state_dir/$name", "$state_dir/aux/$name"
        or die "No such list: $name\n";
}
die "No such file: $data_file\n" unless -f $data_file;

my $state_file = $opt{state}
              // (defined $state_dir
                    ? "$state_dir/" . basename($data_file) . '.state.json'
                    : "$data_file.state.json");

# Progress kept in Subversion: brought up to date before the drill, and
# committed when it ends (see sync_in); a list of one's own there likewise
# brought up to date before it is read (list_in).
my $sync = $svn_dir && dirname($state_file) eq $state_dir;
my $state_saved = 0;
my $sync_unreachable = 0;
sync_in($state_file) if $sync;
list_in($data_file) if $sync && !$sync_unreachable && dirname($data_file) eq $state_dir;
END {
    local $?;           # the exit status is the drill's, not svn's
    sync_out($state_file) if $sync && $state_saved;
}

# The derivs table normally sits beside the data file; fall back to the state
# directory so a list of one's own still gets derivations.
my $derivs_file = $opt{derivs} // do {
    my $beside = dirname($data_file) . '/derivs';
    (!-e $beside && defined $state_dir && -e "$state_dir/derivs")
        ? "$state_dir/derivs" : $beside;
    };
my %deriv = load_derivs($derivs_file);

my @records   = load_records($data_file, $opt{field});
die "No usable records in $data_file\n" unless @records;

# A sentence list with lessons marked in it (utts: "# {7}" before the
# sentence lesson 7 goes with) is taught as MacTeach 1 taught it: the new
# sentences come in order, and each lesson is shown before the first new
# sentence it goes with.  The lessons are in m1-text, beside the list or in
# the data directory.  --random drills the list as any other, without them.
my %lesson;
my $in_order = 0;
if (!$opt{random} && grep { $_->{lessons} } @records) {
    my ($file) = grep { defined && -f } $opt{lessons}, dirname($data_file) . '/m1-text',
                                         (defined $state_dir ? "$state_dir/m1-text" : undef);
    if ($file) {
        %lesson   = load_lessons($file);
        $in_order = 1;
    } else {
        warn "No m1-text for this list's lessons; drilling it at random (see --lessons).\n";
    }
}

my $state = load_state($state_file, $data_file);
if ($opt{reset}) {
    $state->{items} = {};
    save_state($state_file, $state);
    say "State reset.";
    exit 0;
}

show_status($state, \@records) if $opt{status};
exit 0 if $opt{status};

say "Loglan drill: ", basename($data_file),
    "  (", scalar(@records), " items, ",
    "$opt{rungs} rungs, escape=$opt{escape}, dir=$opt{dir})";
say "Type the answer and press Enter.  Blank line = show answer.  :q = quit.  :s = status.  :r = ask the last one again.";
say "";

drill_loop($state, \@records);

# ---- I/O ----

# What lists there are, how big, and which have progress saved.  The lists
# loglan-update builds and installs come first, in the order one learns them; then any other auxiliary
# list, and any other list that has progress filed in the directory -- one of
# your own, kept wherever it is.
sub show_tables ($dir) {
    die "No list directory: set LOGLAN_STATE_DIR or run loglan-update\n" unless defined $dir;
    my @known = qw(core prims affs affsets utts animals ethnic coined l1prims);
    my %known = map { $_ => 1 } @known;
    opendir my $dh, $dir or die "opendir $dir: $!";
    my @own = grep { !$known{$_} } map { /^(.+)\.state\.json\z/ ? $1 : () } readdir $dh;
    closedir $dh;
    if (opendir my $ah, "$dir/aux") {
        push @own, grep { !$known{$_} && !/^\./ && !/\.old\z/ && -f "$dir/aux/$_" } readdir $ah;
        closedir $ah;
    }
    my %once;
    @own = grep { !$once{$_}++ } sort @own;
    for my $t (@known, @own) {
        my ($file) = grep { -f } "$dir/$t", "$dir/aux/$t";
        $file //= "$dir/$t";
        my $saved = -f "$dir/$t.state.json" ? '   (progress saved)' : '';
        if (-f $file) {
            open my $fh, '<', $file or die "open $file: $!";
            # Blank lines and '#' comments are not entries (see parse_words).
            my $n = 0;
            while (my $line = <$fh>) {
                $n++ unless $line =~ /^\s*(?:#|\z)/;
            }
            printf "%-10s %6d entries%s\n", $t, $n, $saved;
        } elsif ($saved) {
            printf "%-10s %6s        %s\n", $t, '', $saved =~ s/^\s+//r;
        }
    }
}

# Once a day, loglan-update looks online for changed sources -- in the
# background, so the drill starts at once and a new dictionary is used from
# the next run.  LOGLAN_NO_UPDATE=1 turns it off.
sub start_update ($dir) {
    return if $ENV{LOGLAN_NO_UPDATE};
    my $stamp = "$dir/src/.last-check";
    my $nw    = "$dir/new-words.json";
    # ... or sooner, when your words have changed since coined was built.
    my $words_changed = -f $nw && (!-e "$dir/coined" || -M $nw < -M "$dir/coined");
    return if !$words_changed && -e $stamp && time - (stat $stamp)[9] < 24 * 60 * 60;
    my $up = -x "$RealBin/loglan-update" ? "$RealBin/loglan-update" : 'loglan-update';
    # Forked twice, so it is nobody's child to wait for.
    my $pid = fork // return;
    if ($pid) {
        waitpid $pid, 0;
        return;
    }
    fork and _exit(0);
    setsid();
    open STDIN,  '<', '/dev/null';
    open STDOUT, '>', '/dev/null';
    open STDERR, '>', '/dev/null';
    exec($up, '--auto', '--dir', $dir) or _exit(0);
}

# What the background update did since last time, said once.
sub show_update_note ($dir) {
    my $note = "$dir/UPDATED";
    return unless -s $note;
    open my $fh, '<', $note or return;
    print "Note: $_" for <$fh>;
    close $fh;
    unlink $note;
    print "\n";
}

sub load_records ($file, $field) {
    open my $fh, '<:encoding(UTF-8)', $file or die "open $file: $!";
    my @lines = <$fh>;
    close $fh;
    s/\r?\n\z// for @lines;
    return parse_words(\@lines, $field);
}

sub parse_words ($lines, $field) {
    # Row layout: <loglan> \t <affix> \t <gloss> \t <place-notes>
    # or, for utterance files, just <loglan> \t <english>.
    # A line starting with '#' is commented out.
    my (@out, @lessons);
    for my $line (@$lines) {
        next unless length $line;
        # "# {7}": lesson 7 of m1-text goes before the next sentence.
        if ($line =~ /^\s*#\s*\{(\d+)\}\s*\z/) {
            push @lessons, $1;
            next;
        }
        next if $line =~ /^\s*#/;
        my @f = split /\t/, $line;
        my ($loglan, $affix, $gloss) = @f >= 3 ? @f[0, 1, 2] : ($f[0], undef, $f[1]);
        for ($loglan, $affix, $gloss) { s/^\s+|\s+$//g if defined $_ }
        next unless length $loglan;
        next if $loglan =~ /^\d+$/;
        my $answer = $field eq 'affix' ? $affix : $gloss;
        next unless defined $answer && length $answer && $answer ne '-';
        # Two-column rows are sentences, written in MacTeach's notation for
        # alternatives (see the MacTeach section below).
        # Progress is kept by the Loglan word -- or, for a sentence, by the
        # Loglan and the English together, since some sentences come twice,
        # with a literal and an idiomatic English (Tu he: "You are what?",
        # "How are you?"), and each is a card of its own.
        my $sentence = @f < 3;
        push @out, { loglan => $loglan, answer => $answer, sentence => $sentence,
                     key => ($sentence ? "$loglan\t$answer" : $loglan),
                     index => scalar @out, (@lessons ? (lessons => [@lessons]) : ()) };
        @lessons = ();
    }
    return @out;
}

# m1-text: "{n}" on a line of its own starts lesson n.  The '#' lines at the
# top are its header.
sub load_lessons ($file) {
    open my $fh, '<:encoding(UTF-8)', $file or die "open $file: $!";
    my (%text, $n);
    while (my $line = <$fh>) {
        $line =~ s/\r?\n\z//;
        if ($line =~ /^\{(\d+)\}\s*\z/) { $n = $1; $text{$n} = ''; next }
        next unless defined $n;
        $text{$n} .= "$line\n";
    }
    close $fh;
    s/\s+\z/\n/ for values %text;
    return %text;
}

# ---- MacTeach sentence notation ----
# The utterance files keep the notation of the Institute's MacTeach, whose
# DataFile.txt and mainsent() define it:
#
#   space      ends a word group;  '-' joins words within one ("brother-of")
#   a/b        alternatives
#   + and &    close a set of alternatives, '+' with a space after it and '&'
#              without:  "is/s+a/the+brother-of" is (is|'s) (a|the) brother of
#   = and :    open one after fixed words, '=' with a space and ':' without:
#              "there/to=X/it" is there | to (X|it), "grand:father/parent"
#   (x)        optional;  (*x) optional, but shown in the sentence as displayed
#   \c         c taken literally (MacTeach also used it to mark punctuation the
#              answer must have; here Loglan commas always count, and all
#              other punctuation never does)
#   |note      the rest of an English line is a note;  [note] in the Loglan
#
# A sentence compiles to a pattern rather than a list of wordings, since
# "Y/he(is)/she(is) is/s+older-than ..." alone has hundreds.  Answers are
# compared with case, spaces, hyphens and punctuation ignored, Loglan commas
# excepted.

sub mt_split_note ($text) {
    my ($body, $note) = ($text, '');
    if ($body =~ s/\s*\[(.*?)\]\s*//) { $note = $1 }            # Loglan
    elsif ($body =~ s/(?<!\\)\|(.*)\z//s) { $note = $1 }        # English
    $note =~ s/\\(.)/$1/g;
    return ($body, $note);
}

# Keep what an answer is compared on: letters and digits, and in Loglan the
# pause commas that are part of its grammar.
sub mt_fold ($s, $loglan) {
    $s = lc $s;
    return $loglan ? $s =~ s/[^a-z0-9,]//gr : $s =~ s/[^a-z0-9]//gr;
}

# Recursive descent over the sentence; each parser returns
# [pattern, displayed text].
sub mt_compile ($text, $loglan) {
    my @c = split //, $text;
    my $i = 0;
    my ($alt, $seg, $group, $sentence);
    my $peek = sub { $i < @c ? $c[$i] : '' };
    $sentence = sub {               # groups separated by spaces
        my ($re, $show) = $group->();
        while ($peek->() eq ' ') {
            $i++ while $peek->() eq ' ';
            last if $peek->() eq '' || $peek->() eq ')';
            my ($r, $s) = $group->();
            $re .= $r;  $show .= " $s";
        }
        return ($re, $show);
    };
    $group = sub {                  # sets joined by + (space) and & (none)
        my ($re, $show) = $seg->();
        while ($peek->() eq '+' || $peek->() eq '&') {
            my $sep = $c[$i++] eq '+' ? ' ' : '';
            my ($r, $s) = $seg->();
            $re .= $r;  $show .= "$sep$s";
        }
        return ($re, $show);
    };
    $seg = sub {                    # a set of alternatives
        my @alts = ($alt->());
        while ($peek->() eq '/') { $i++; push @alts, $alt->() }
        return @alts == 1 ? @{ $alts[0] }
             : ('(?:' . join('|', map { $_->[0] } @alts) . ')', $alts[0][1]);
    };
    $alt = sub {                    # fixed text, then perhaps = or : and a set
        my ($re, $show) = ('', '');
        while (1) {
            my $ch = $peek->();
            last if $ch eq '' || $ch =~ m{[ +&/)]};
            if ($ch eq '=' || $ch eq ':') {
                $i++;
                my ($r, $s) = $seg->();
                return [$re . $r, $show . ($ch eq '=' ? ' ' : '') . $s];
            }
            $i++;
            if ($ch eq '(') {
                my $star = $peek->() eq '*' ? ($i++, 1) : 0;
                my ($r, $s) = $sentence->();
                $i++ if $peek->() eq ')';
                $re .= "(?:$r)?";
                $show .= $s if $star;
                next;
            }
            $ch = $c[$i++] // '' if $ch eq '\\';
            $ch = ' ' if $ch eq '-';
            $show .= $ch;
            my $f = mt_fold($ch, $loglan);
            $re .= quotemeta $f if length $f;
        }
        return [$re, $show];
    };
    my ($re, $show) = $sentence->();
    $show =~ s/\s+/ /g;
    $show =~ s/ ([,.!?;:])/$1/g;
    $show =~ s/^ | $//g;
    return (qr/\A$re\z/, $show);
}

my %mt_cache;
sub mt ($text, $loglan) {
    $mt_cache{"$loglan\0$text"} //= do {
        my ($body, $note) = mt_split_note($text);
        my ($re, $show) = mt_compile($body, $loglan);
        { re => $re, show => $show, note => $note };
    };
}

sub mt_match ($reply, $text, $loglan) {
    return mt_fold($reply, $loglan) =~ mt($text, $loglan)->{re};
}

# <word> \t <the word it came from, or '-'> \t <the natural-language words
# that one was built from, or '-'>, as written by mk-utility.  A missing
# table just means no derivations are shown.
sub load_derivs ($file) {
    return () if $opt{noderivs} || !-f $file;
    open my $fh, '<:encoding(UTF-8)', $file or die "open $file: $!";
    my %d;
    while (my $line = <$fh>) {
        $line =~ s/\r?\n\z//;
        my ($word, $base, $from) = split /\t/, $line;
        next unless length($word // '') && defined $from;
        $d{$word} = [ $base, $from ];
    }
    close $fh;
    return %d;
}

sub load_state ($file, $data_file) {
    return { version => 1, data_file => basename($data_file), items => {} }
        unless -f $file;
    open my $fh, '<:encoding(UTF-8)', $file or die "open $file: $!";
    local $/;
    my $json = <$fh>;
    close $fh;
    my $s = eval { decode_json($json) } // {};
    $s->{items} //= {};
    $s->{version} //= 1;
    return $s;
}

sub save_state ($file, $state) {
    my $tmp = "$file.tmp";
    open my $fh, '>:encoding(UTF-8)', $tmp or die "open $tmp: $!";
    print $fh JSON::PP->new->canonical->pretty->encode($state);
    close $fh;
    rename $tmp, $file or die "rename $tmp $file: $!";
    $state_saved = 1;
}

# ---- Progress kept in Subversion ----
# When ~/.loglan (or $LOGLAN_STATE_DIR) is a Subversion working copy -- has a
# .svn of its own, checked out from a repository of yours -- the drill brings it up to date before
# it starts and commits it when you quit, so your progress goes with you
# from one machine to the next.  Where the copy here and the repository's
# have both changed, they are merged word by word.  No connection (away
# from the server's network, say) only means the drill goes on with the copy
# here, which is committed the next time it can be.  ssh never asks for a
# passphrase: the key has to be in your agent.  A list of one's own kept
# there is brought up to date the same way (list_in), and fetched when it is
# not here yet.  LOGLAN_NO_SYNC=1 or --no-sync turns it off.

# Runs svn, never interactively; returns whether it worked, and what it said.
sub svn (@args) {
    local $ENV{SVN_SSH} = $ENV{SVN_SSH} // 'ssh -o BatchMode=yes -o ConnectTimeout=5';
    my $pid = open(my $fh, '-|') // return (0, "svn: cannot fork: $!");
    if (!$pid) {
        open STDERR, '>&', \*STDOUT;
        exec('svn', '--non-interactive', @args) or _exit(127);
    }
    my $out = do { local $/; <$fh> } // '';
    close $fh;
    return ($? == 0, $out);
}

sub sync_note ($what, $out) {
    $sync_unreachable = 1;
    warn "(progress not $what -- ", svn_why($out), "; the copy here is kept, and committed next time)\n";
}

# The line of what svn said that says why it failed.
sub svn_why ($out) {
    my ($why) = reverse grep { /^svn: E\d/ } split /\n/, $out;
    return $why // ($out =~ /\S/ ? (split /\n/, $out)[-1] : 'svn not found');
}

sub sync_in ($file) {
    my ($ok, $st) = svn('status', $file);
    return sync_note('brought up to date', $st) unless $ok;
    # Changed here (or not yet committed at all): set it aside, take the
    # repository's, and merge the two -- a text merge of two JSON files
    # need not be JSON.
    my $mine;
    if ($st =~ /^[MAC?]/m && -f $file) {
        $mine = "$file.local";
        rename $file, $mine or die "rename $file $mine: $!";
        svn('revert', '-q', $file);
        unlink $file if $st =~ /^[A?]/m;
    }
    my ($up, $out) = svn('update', '-q', '--accept', 'theirs-full', $file);
    if (!$up) {
        rename $mine, $file if defined $mine;
        return sync_note('brought up to date', $out);
    }
    return unless defined $mine;
    if (-f $file) {
        my $merged = merge_states(load_state($mine, $file), load_state($file, $file));
        my $had = $state_saved;
        save_state($file, $merged);
        $state_saved = $had;
        unlink $mine;
    } else {
        rename $mine, $file;
    }
}

# A list of one's own kept in the repository (the built ones are ignored) is
# brought up to date as well, before it is read -- unless it has been
# changed here and not committed, when it is left as it is.
sub list_in ($file) {
    my ($ok, $st) = svn('status', $file);
    return unless $ok && $st !~ /^[MACDR?I!~]/m;
    my ($up, $out) = svn('update', '-q', '--accept', 'theirs-full', $file);
    warn "(list not brought up to date -- ", svn_why($out), ")\n" unless $up;
}

sub sync_out ($file) {
    return if $sync_unreachable;    # said so at the start; tried again next time
    for my $try (1, 2) {
        my ($ok, $st) = svn('status', $file);
        return sync_note('committed', $st) unless $ok;
        return unless $st =~ /^[MA?]/m;
        svn('add', '-q', $file) if $st =~ /^\?/m;
        my $host = (POSIX::uname())[1];
        my ($done, $out) = svn('commit', '-q', '-m', basename($file) . " from $host", $file);
        return if $done;
        # Committed from somewhere else meanwhile: merge that in, and again.
        return sync_note('committed', $out) unless $try == 1 && $out =~ /out of date|E155011|E160028|E170004/i;
        sync_in($file);
    }
}

# Two copies of one list's progress, as one: each word as the copy that has
# seen it more often has it (this one's, on a tie); the lessons either has
# shown; and the place in an in-order list that is further on.
sub merge_states ($mine, $theirs) {
    my %m = %$theirs;
    $m{$_} = $mine->{$_} for grep { $_ ne 'items' } keys %$mine;
    my ($a, $b) = ($mine->{items} // {}, $theirs->{items} // {});
    $m{items} = { %$b, map {
        my $t = $b->{$_};
        ($_ => (!$t || ($a->{$_}{seen} // 0) >= ($t->{seen} // 0)) ? $a->{$_} : $t)
    } keys %$a };
    $m{lessons_shown} = { %{ $theirs->{lessons_shown} // {} }, %{ $mine->{lessons_shown} // {} } }
        if $mine->{lessons_shown} || $theirs->{lessons_shown};
    my ($om, $ot) = ($mine->{order}, $theirs->{order});
    $m{order} = $ot if $om && $ot
        && (($ot->{pass} // 1) <=> ($om->{pass} // 1) || ($ot->{next} // 0) <=> ($om->{next} // 0)) > 0;
    return \%m;
}

# ---- Drill ----

sub item_state ($state, $prompt) {
    return $state->{items}{$prompt} //= {
        rung => 1, in_error => 0, streak => 0, seen => 0, correct => 0,
    };
}

sub pick_record ($state, $records) {
    my @weights;
    for my $r (@$records) {
        my $s      = $state->{items}{ $r->{key} };   # read without autoviv
        my $rung   = $s ? $s->{rung}     : 1;
        my $in_err = $s ? $s->{in_error} : 0;
        # Error-box items get top weight; ladder items weighted toward
        # low rungs. Rung > $opt{rungs} means graduated (weight 0).
        my $w = $in_err                ? $opt{rungs} + 2
              : $rung > $opt{rungs}    ? 0
              :                          $opt{rungs} - $rung + 2;
        push @weights, $w;
    }
    my $total = sum0 @weights;
    if ($total == 0) {
        # Everything graduated. Re-open the top rung for lifetime review.
        @weights = (1) x @$records;
        $total   = scalar @$records;
    }
    my $roll = rand() * $total;
    my $acc  = 0;
    for my $i (0 .. $#$records) {
        $acc += $weights[$i];
        return $records->[$i] if $roll < $acc;
    }
    return $records->[-1];
}

sub choose_direction () {
    return $opt{dir} eq 'both'
        ? (rand() < 0.5 ? 'recognition' : 'recall')
        : $opt{dir};
}

sub drill_loop ($state, $records) {
    my $asked = 0;
    local $SIG{INT} = sub { save_state($state_file, $state); say "\nSaved."; exit 0 };

    # ':r' asks the card before this one again, then this one: both wait
    # here, each as it was asked.
    my (@ahead, $prev);
    while (1) {
        my ($r, $kind, $direction);
        if (@ahead) { ($r, $kind, $direction) = @{ shift @ahead } }
        else {
            ($r, $kind) = $in_order ? next_in_order($state, $records)
                                    : (pick_record($state, $records), '');
            show_lessons($state, $records, $r) if $kind eq 'new';
            $direction = choose_direction();
        }
        my ($prompt, $expected) =
            $direction eq 'recognition'
            ? ($r->{loglan}, $r->{answer})
            : ($r->{answer}, $r->{loglan});
        # A sentence is shown as MacTeach showed it: the main wording, without
        # the alternatives; a Loglan note goes with the prompt.
        my $loglan_prompt = $direction eq 'recognition';
        if ($r->{sentence}) {
            my $p = mt($prompt, $loglan_prompt);
            $prompt = $p->{show} . ($loglan_prompt && length $p->{note} ? "   [$p->{note}]" : '');
        }

        # ':s' is a look, not an answer: show the histogram and then ask the
        # same card again instead of moving on to the next one.
        my $reply;
        while (1) {
            say "";
            say "  $prompt";
            print "  > ";
            $reply = <STDIN>;
            last unless defined $reply;
            chomp $reply;
            # A backslash is never part of an answer, only a slip of the
            # finger beside Enter; drop it before anything else looks.
            $reply =~ tr/\\//d;
            $reply =~ s/^\s+|\s+$//g;
            # The commands are taken however they are capitalised.
            $reply = lc $reply if $reply =~ /\A:/;
            last unless $reply =~ /\A:/;
            last if $reply eq ':q' || ($reply eq ':r' && $prev);
            # ':l' shows the lesson this card goes with, then the same card;
            # ':1' is taken for it, the two look so alike.
            if ($reply eq ':l' || $reply eq ':1') { show_card_lessons($records, $r) }
            elsif ($reply eq ':s') { show_status($state, $records) }
            elsif ($reply eq ':r') { say "  (nothing asked before this one yet)" }
            # Anything else after a ':' is a slip, not an answer.
            else { say "  $_" for '(not a command:', '  :s  status', '  :l  the lesson this card goes with',
                                  '  :r  ask the card before this one again', '  :q  quit and save)' }
        }
        last unless defined $reply;

        if ($reply eq ':q') { last }
        if ($reply eq ':r') {
            unshift @ahead, $prev, [ $r, $kind, $direction ];
            undef $prev;
            next;
        }

        my $s = item_state($state, $r->{key});
        $s->{seen}++;
        $asked++;

        # A sentence with no translation -- ungrammatical, its English just
        # "-" and a note why (Tu nirne ho) -- is answered with a "-".
        my $none  = $r->{sentence} && (mt_split_note($expected))[0] =~ /\A\s*-\s*\z/;
        my $right = $none            ? $reply eq '-'
                  : $r->{sentence}   ? mt_match($reply, $expected, !$loglan_prompt)
                  :                    match_answer($reply, $expected);
        if ($reply eq '') {
            demote($s);
        }
        elsif ($right) {
            say "     ok" . ($s->{in_error} ? "  [error-box ${\ ($s->{streak}+1) }/$opt{escape}]" : "  [rung ${\ ($s->{rung}) }->${\ ($s->{rung}+1) }]");
            $s->{correct}++;
            promote($s);
        }
        else {
            say "     no";
            demote($s);
        }
        after_in_order($state, $r, $kind, $right && $reply ne '') if $in_order;
        # Asked again, it is graded again, as one gone over: right takes it
        # off the in-order retry list, wrong puts it at the back.
        $prev = [ $r, $kind eq 'new' ? 'retry' : $kind, $direction ];
        if ($none) {
            # The answer, and the note on why there is none to give.
            my (undef, $why) = mt_split_note($expected);
            $why =~ s/\A\s*\((.*)\)\s*\z/$1/s;
            say "     - (no translation)";
            say "     ($why)" if length $why;
        }
        elsif ($r->{sentence}) {
            my $e = mt($expected, !$loglan_prompt);
            say "     $e->{show}";
            say "     ($e->{note})" if length $e->{note} && !$loglan_prompt;
        }
        else {
            say "     ", join ' / ', accepted_answers($expected);
            show_derivation($r->{loglan});
        }

        save_state($state_file, $state) if $asked % 5 == 0;
    }
    save_state($state_file, $state);
    say "\nSaved.";
}

# Before the next sentence in order, every lesson up to it not yet shown, in
# the order the list has them -- for a new learner, just the ones that go
# with it.  Each is shown once.
sub show_lessons ($state, $records, $r) {
    my @due = grep { !$state->{lessons_shown}{$_} }
              map { @{ $_->{lessons} // [] } } @$records[ 0 .. $r->{index} ];
    return unless @due;
    for my $n (@due) {
        show_lesson($n);
        $state->{lessons_shown}{$n} = 1;
        print "  (Enter to go on) ";
        my $go = <STDIN>;
        last unless defined $go;
    }
    save_state($state_file, $state);
}

# The lesson a card goes with: the nearest one marked at or before it.
sub show_card_lessons ($records, $r) {
    return say "  (this list has no lessons)" unless %lesson;
    for my $i (reverse 0 .. $r->{index}) {
        my $l = $records->[$i]{lessons} or next;
        show_lesson($_) for @$l;
        return;
    }
    say "  (no lesson comes before this card)";
}

# In order, as MacTeach 1 went: every sentence in its turn.  One you miss
# goes on a retry list, which is gone through -- until each is right --
# before the next lesson begins and at the end of the list; after the end,
# it starts again from the top.  Returns the card and whether it is the
# next new one ('new') or a retry.
sub next_in_order ($state, $records) {
    my $q = $state->{order} //= { next => 0, retry => [], pass => 1 };
    my %by_key = map { $_->{key} => $_ } @$records;
    @{ $q->{retry} } = grep { $by_key{$_} } @{ $q->{retry} };   # the list may have changed
    my $n = $q->{next};
    if (@{ $q->{retry} } && ($n > $#$records || $records->[$n]{lessons})) {
        say "\n  (going over the ones missed, before going on)" unless $q->{retrying}++;
        return ($by_key{ $q->{retry}[0] }, 'retry');
    }
    delete $q->{retrying};
    if ($n > $#$records) {
        $q->{next} = $n = 0;
        $q->{pass}++;
        say "\n  ---- That was all ${\ scalar @$records}; from the top again (time $q->{pass}) ----";
    }
    return ($records->[$n], 'new');
}

sub after_in_order ($state, $r, $kind, $right) {
    my $q = $state->{order};
    my @retry = grep { $_ ne $r->{key} } @{ $q->{retry} };
    if ($kind eq 'new') {
        $q->{next}++;
        push @retry, $r->{key} unless $right;
    } elsif (!$right) {
        push @retry, $r->{key};          # to the back of the line
    }
    $q->{retry} = \@retry;
}

sub show_lesson ($n) {
    say "";
    say "  ---- Lesson $n ----";
    print map { "  $_\n" } split /\n/, $lesson{$n} // "(not in the lessons file)\n";
}

# "ladza", "ladze", "ladzi" and "ladzu" were all coined from "ladzo", so the
# ethnic and animal declensions show the derivation of the word that came
# first.  Words that stand on their own show their own.
sub show_derivation ($loglan) {
    my $d = $deriv{$loglan} or return;
    my ($base, $from) = @$d;
    my $line = $base eq '-' ? '' : $base;
    $line .= (length $line ? "  [$from]" : $from) unless $from eq '-';
    say "     from: $line" if length $line;
}

sub promote ($s) {
    if ($s->{in_error}) {
        $s->{streak}++;
        if ($s->{streak} >= $opt{escape}) {
            $s->{in_error} = 0;
            $s->{streak}   = 0;
            $s->{rung}     = 1;
        }
    }
    else {
        $s->{rung}++;
    }
}

sub demote ($s) {
    $s->{in_error} = 1;
    $s->{streak}   = 0;
    $s->{rung}     = 0;
}

# Every spelling the drill will take for $expected, which is also what it
# lists back after each card: what the list says, and, for an "X-like" (the
# -e of an animal), "Xish" -- nothing else is made up here.
sub accepted_answers ($expected) {
    my (@gloss, %seen);
    for my $a (split m{[/|]}, $expected) {
        $a =~ s/^\s+|\s+$//g;
        next unless length $a;
        for my $v (expand_optionals($a)) {
            my $n = normalize($v);
            next unless length $n;
            # "sheep like", "sheeplike" and "sheep-like" are one answer.
            push @gloss, $n unless $seen{ match_key($n) }++;
            if ($n =~ /^(.+) like\z/i) {
                my $ish = ish($1);
                push @gloss, $ish unless $seen{ match_key($ish) }++;
            }
        }
    }
    return @gloss;
}

sub match_answer ($reply, $expected) {
    my $k = match_key(normalize($reply));
    return scalar grep { $k eq match_key($_) } accepted_answers($expected);
}

# Neither case nor spacing counts, so a gloss written one way ("fish-like")
# takes a reply written the other ("Fishlike").
sub match_key ($s) { return lc($s) =~ s/ //gr }

# "X" + "ish", spelled as English spells it: a silent e goes ("horsish"),
# and the last consonant of a one-syllable word ending in one vowel and one
# consonant is doubled ("rattish", "guinea piggish"), but not w, x or y
# ("cowish").
sub ish ($x) {
    $x =~ s/(?<=[^e])e\z//i
        or $x =~ s/(?:^|(?<= ))[^aeiou ]*[aeiou]\K([b-df-hj-np-tvz])\z/$1$1/i;
    return "${x}ish";
}

# Hyphens, underscores and runs of whitespace all count as one word break,
# so "lion cub" matches "lion-cub" and "lion like" matches "lion_like".
sub normalize ($s) {
    $s =~ s/[-_\s]+/ /g;
    $s =~ s/^ | $//g;
    return $s;
}

# "vapo(u)r" -> ("vapor", "vapour"): parenthesised letters are optional.
# A dash left dangling at either end after removal (e.g. "Loglan-(language)"
# -> "Loglan-", "(house)-fly" -> "-fly") is dropped too.
sub expand_optionals ($s) {
    my @out = ($s);
    while (1) {
        my $changed = 0;
        @out = map {
            if (/^(.*?)\(([^()]*)\)(.*)$/s) {
                $changed = 1;
                my ($pre, $in, $post) = ($1, $2, $3);
                my $without = $pre . $post;
                $without =~ s/-\z// if $post eq '';
                $without =~ s/\A-// if $pre  eq '';
                ($without, "$pre$in$post");
            }
            else { $_ }
        } @out;
        last unless $changed;
    }
    return @out;
}

sub show_status ($state, $records) {
    my %hist;
    my $err = 0;
    my $grad = 0;
    for my $r (@$records) {
        my $s = $state->{items}{$r->{key}};
        if (!$s)                 { $hist{new}++; next }
        if ($s->{in_error})      { $err++;  next }
        if ($s->{rung} > $opt{rungs}) { $grad++; next }
        $hist{ $s->{rung} }++;
    }
    say "";
    say "  status:";
    say sprintf("    new       %5d", $hist{new} // 0);
    say sprintf("    error-box %5d", $err);
    for my $r (1 .. $opt{rungs}) {
        say sprintf("    rung %d    %5d", $r, $hist{$r} // 0);
    }
    say sprintf("    graduated %5d", $grad);
    say sprintf("    total     %5d", scalar @$records);
    if ($in_order) {
        my $q = $state->{order} // { next => 0, retry => [], pass => 1 };
        say sprintf("    in order: next is %d of %d (time %d through); %d to go over again",
                    $q->{next} + 1, scalar @$records, $q->{pass}, scalar @{ $q->{retry} });
    }
}

sub usage {
    my $me = basename($0);
    print <<"USAGE";
Usage: $me [options] <data-file>

  Ladder + error-box drill for Loglan vocabulary and utterances.  Reads
  tab-separated files: <loglan>\t<affix>\t<gloss>\t<notes> (core, prims, affs,
  affsets, ethnic, animals, l1prims) or <loglan>\t<answer> (utts or your own
  lists).  A bare name such as 'prims' is looked for in \$LOGLAN_STATE_DIR
  (default ~/.loglan), where loglan-update puts the lists, and then among
  the auxiliary lists in its aux/ (ethnic, animals, and any of your own).

  Once a day it starts loglan-update in the background to look for new
  Loglan sources online; LOGLAN_NO_UPDATE=1 stops it.

Direction:
  --recognition    prompt Loglan, expect gloss   [default]
  --recall         prompt gloss, expect Loglan
  --both           alternate randomly

Ladder:
  --rungs N        rungs on the ladder            [default 5]
  --escape K       correct answers to leave the   [default 2]
                     error box and re-enter rung 1
  --field FIELD    for AFFS/AFFSETS: 'gloss' or 'affix'  [default gloss]

Derivations:
  --derivs FILE    word-origin table shown after each answer
                     [default 'derivs' beside the data file]
  --no-derivs      do not show derivations

Lessons (utts):
  A sentence list with lessons marked in it ("# {7}" before a sentence) is
  taught as MacTeach 1 taught it: every sentence in its turn, from the top,
  each lesson of m1-text shown before the sentences it goes with.  A sentence
  you miss is asked again, until you have it, before the next lesson starts.
  --lessons FILE   the lessons [default m1-text beside the list, or in
                     \$LOGLAN_STATE_DIR]
  --random         drill the list on the ladder instead, at random, without
                     the lessons

State:
  --state FILE     path to state file  [default \$LOGLAN_STATE_DIR (or ~/.loglan)
                     /<data-file>.state.json]
  --reset          wipe progress for this data file
  --no-sync        when the state file is in a Subversion working copy, do
                     not update it (or a list of your own there) first or
                     commit it after (as LOGLAN_NO_SYNC=1)
  --status         print progress histogram and exit
  --tables         list the lists in \$LOGLAN_STATE_DIR, their sizes, and
                     which have progress saved (no data-file needed)

In-drill commands:
  <answer>+Enter   grade your answer
  Enter alone      give up on this card (counts as a miss)
  :s               status
  :l               show the lesson this card goes with (:1 works too)
  :r               ask the card before this one again, graded, then this one
  -                for a sentence with no translation (ungrammatical), the
                     answer
  :q               quit and save

USAGE
    exit 0;
}
