#!/usr/bin/env perl
use v5.36;
use FindBin qw($RealBin);

# loglan-fetch is now loglan-update: the sources ship with the tools, and
# loglan-update brings them up to date and builds the lists.  This is here so
# that old habits and scripts keep working; --refresh is no longer needed.

my $up = -x "$RealBin/loglan-update" ? "$RealBin/loglan-update" : 'loglan-update';
exec($up, grep { $_ ne '--refresh' } @ARGV) or die "loglan-fetch: cannot run $up: $!\n";
