use v5.36;
use utf8;
use open ':std', ':encoding(UTF-8)';

use Getopt::Long qw(:config bundling no_ignore_case);

# Builds a practice cheat-sheet (vocab-cheatsheet.html) plus two drill files
# for loglan-teach -- l1prims and derivs -- from the prims list, the auxiliary
# ethnic and animals lists, Loglan 1 and Lavinia Randall Holmes's
# Loglan-to-English dictionary, all of which loglan-update puts in the data
# directory (it runs this script itself).  l1prims is the set of primitives
# actually used in the main text (chapters 1-7); Appendix B supplies their
# book definitions.  derivs is the word-origin table loglan-teach shows after
# each answer.
#
# The ethnic and animals lists ship with the tools (lists/aux), curated by
# hand; everything here about the declension sets is read from them.

my %opt;
GetOptions(\%opt, 'dir=s', 'replace-links', 'help|h') or die "Try --help\n";
if ($opt{help}) {
    print <<"END";
Usage: mk-utility [--dir DIR] [--replace-links]

Builds vocab-cheatsheet.html and the l1prims and derivs drill lists in DIR
(default \$LOGLAN_STATE_DIR, else ~/.loglan) from what loglan-update put
there.  A list that is a symlink is left alone unless --replace-links is
given.
END
    exit 0;
}
my $dir = $opt{dir} // $ENV{LOGLAN_STATE_DIR} // "$ENV{HOME}/.loglan";

my $prims_file = "$dir/prims";
my $l1_dir     = "$dir/src/Loglan1";
my $appb_file  = "$l1_dir/app-b.html";
my @chapters   = map { "$l1_dir/chap$_.html" } 1 .. 7;
my $dict_file  = "$dir/src/Dictionary/L-to-E-TDR.html";
my @aux_files  = map { "$dir/aux/$_" } qw(ethnic animals);
for ($prims_file, $appb_file, $dict_file, @aux_files) {
    die "$_ is missing -- run loglan-update first\n" unless -f;
}

# Primitive-shaped tokens in the chapters that are only ever the English word.
my %not_loglan = map { $_ => 1 } qw(hindi versa);

# ---- The auxiliary lists: name -> [rows] ----
# loglan-update adds their words to prims, and those are not to be read back
# as primitives; and the declension sets are taken from them.
my %aux;
for my $name (qw(ethnic animals)) {
    my $file = "$dir/aux/$name";
    next unless -f $file;
    open my $fh, '<', $file or die "open $file: $!";
    $aux{$name} = [ grep { /\S/ && !/^\s*#/ } map { s/\r?\n\z//r } <$fh> ];
    close $fh;
}
my %aux_word = map { (split /\t/)[0] => 1 } map { @$_ } values %aux;

# Which words the dictionary itself calls primitives, to tell them from the
# words the auxiliary lists put into prims.
my %dict_prim;
{
    open my $fh, '<', $dict_file or die "open $dict_file: $!";
    my $html = do { local $/; <$fh> };
    close $fh;
    $dict_prim{$1} = 1
        while $html =~ m{<b><a name="([^"]+)">[^<]*</a></b>,\s*<br>[^<]*(?:<em[^>]*>[^<]*</em>\s*)*[^<]*?\b[A-Z]-Prim\b}g;
}

# ---- Institute PRIMS: word -> { affix, gloss, notes, line } ----
my (%prims, @prims_order);
{
    open my $fh, '<', $prims_file or die "open $prims_file: $!";
    my @lines = <$fh>;
    close $fh;
    for (@lines) {
        s/\r?\n\z//;
        my @f = split /\t/, $_;
        next unless @f >= 3;
        my $w = $f[0];
        $_ = defined $_ ? s/^\s+|\s+$//gr : '' for @f;
        next if $f[3] && $f[3] =~ /\(formed by rule\)\z/;   # an auxiliary list's
        next if $aux_word{$w} && !$dict_prim{$w};            # likewise
        $prims{$w} = { affix => $f[1], gloss => $f[2], notes => $f[3] // '', line => $_ };
        push @prims_order, $w;
    }
}

# ---- Loglan 1, Appendix B: [word, affix, definition] ----
my @l1;
{
    open my $fh, '<', $appb_file or die "open $appb_file: $!";
    local $/;
    my $html = <$fh>;
    close $fh;
    while ($html =~ /<DT><B>(.*?)<\/B>\s*<DD>(.*?)(?=<DT>|<\/DL>)/g) {
        my ($w, $d) = ($1, $2);
        s/<!--.*?-->//g for $w, $d;
        $d =~ s/<[^>]*>//g;
        $d =~ s/&amp;/&/g;
        $d =~ s/\s+/ /g;
        $d =~ s/^\s+|\s+$//g;
        my $affix = '-';
        $affix = $1 if $d =~ s/^\(([^)]*)\)\s*//;
        push @l1, [ $w, $affix, $d ];
    }
}
die "Appendix B parse failed\n" unless @l1 > 1000;
my %l1 = map { $_->[0] => $_ } @l1;

# ---- Primitives used in the main text of Loglan 1 ----
# Loglan in the chapters is only partly marked up, so take every five-letter
# token in the running text and keep those that are known primitives.
my %in_text;
for my $file (@chapters) {
    open my $fh, '<:encoding(latin1)', $file or die "open $file: $!";   # chapters are Latin-1
    local $/;
    my $html = <$fh>;
    close $fh;
    $html =~ s/<!--.*?-->//gs;
    $html =~ s/<[^>]*>/ /g;
    $html =~ s/&[a-z]+;/ /g;
    for my $tok ($html =~ /\b([A-Za-z]{5})\b/g) {
        my $w = lc $tok;
        next if $not_loglan{$w};
        $in_text{$w}++ if $l1{$w} || $prims{$w};
    }
}
my @l1_text = sort keys %in_text;
die "chapter scan found only ${\ scalar @l1_text} primitives\n" unless @l1_text > 300;

# ---- The Loglan-to-English dictionary ----
# Every entry carries an origin field: either the natural-language words the
# Loglan word was scored against ("3/4E louse | 2/3C sh dz | 2/4G laus"), or,
# for words coined off an existing one -- affixes, CVV little words, the
# -a/-e/-i/-o/-u ethnic and animal declensions -- that one word.  %dict says
# only which words the dictionary has.
my (%origin, %headword, %dict, @dict_order);
{
    open my $fh, '<', $dict_file or die "open $dict_file: $!";
    my $html = do { local $/; <$fh> };
    close $fh;
    my %entity = (lt => '<', gt => '>', amp => '&', nbsp => ' ', zwj => '',
                  mdash => '-', ndash => '-', quot => '"');
    my $flat = sub ($s) {
        $s =~ s/<[^>]*>//g;
        $s =~ s/&(\w+);/$entity{$1} \/\/ ' '/ge;
        $s =~ s/&#\d+;/ /g;
        $s =~ s/\s+/ /g;
        return $s =~ s/^\s+|\s+$//gr;
    };
    # An entry is
    #   <b><a name="bakso">bakso</a></b>, <br>
    #   <em class="origin">bao</em> <em class="origin">&lt;4/4E box; 3/4J hako&gt;</em>&nbsp;42% C-Prim L4 1975 2.3<br>
    #   &nbsp;&nbsp;&nbsp;(2n) D is a <em class="key">box</em>/... of/containing B. [D-B]<br>
    #   ...</p>
    # -- the affixes, then the origin in angle brackets, then the word class.
    while ($html =~ m{<b><a name="([^"]+)">[^<]*</a></b>,\s*<br>\s*(.*?)</p>}gs) {
        my ($w, $body) = ($1, $2);
        next if $headword{$w}++;
        $dict{$w} = 1;
        my ($head) = split /<br>/, $body;
        my ($o) = $head =~ m{<em class="origin">&lt;(.*?)&gt;</em>}s or next;
        $o = $flat->($o);
        next unless length $o;
        $origin{$w} = $o;
        push @dict_order, $w;
    }
}
die "dictionary parse failed: $dict_file\n" unless @dict_order > 5000;

# Case, hyphens and spaces do not tell two glosses apart, the drill matching
# answers the same way.
sub gloss_key ($s) { return lc($s) =~ s/[-\s]//gr }

# ---- Your own additions ----
# <list>.added beside a list holds entries of your own, in the list's own
# layout; blank lines and lines starting with '#' are skipped.  When the list
# is written, an added entry replaces the built one for the same word, and the
# rest are appended.  Nothing here ever writes to a .added file.
sub read_added ($name) {
    my $file = "$dir/$name.added";
    return () unless -f $file;
    open my $fh, '<', $file or die "open $file: $!";
    my @rows = grep { /\S/ && !/^\s*#/ } map { s/\r?\n\z//r } <$fh>;
    close $fh;
    return @rows;
}

sub merge_added ($name, $rows) {
    my @add = read_added($name) or return $rows;
    my %add = map { (split /\t/)[0] => $_ } @add;
    my %done;
    my @out = map { my $w = (split /\t/)[0];
                    $add{$w} ? do { $done{$w} = 1; $add{$w} } : $_ } @$rows;
    push @out, grep { !$done{ (split /\t/)[0] } } @add;
    return \@out;
}

# ---- The declension sets, as the auxiliary lists have them ----
# Which sets there are, and every word in them.  A member formed by rule is
# drawn as one.
my %ethnic_stem;
for (@{ $aux{ethnic} }) {
    my ($w) = split /\t/;
    $ethnic_stem{$1} = 'aux' if $w =~ /^(\w+)[aeio]\z/;
}
my (%animal_stem, %animal_word);
for (@{ $aux{animals} }) {
    my ($w, $affix, $gloss, $notes) = split /\t/;
    $notes //= '';
    next unless $w =~ /^(\w+)([uaoie])\z/;
    $animal_stem{$1} = 1 if $2 eq 'u';
    next if $notes =~ /\(formed by rule\)\z/;
    $animal_word{$w} = { affix => $affix, gloss => $gloss, notes => $notes, line => $_,
                         dict => (!$prims{$w} && $dict{$w} ? 1 : 0) };
}

# ---- Words in Loglan 1 that are no longer in PRIMS ----
my %replaced = (
    birhu => 'birju', canse => 'tcane', cupri => 'cupro', curdi => 'surba',
    sirna => 'sirto', snalu => 'snalo', soske => 'suske', tulpi => 'tulpa',
);
my %orphan_gloss = (
    birhu => 'beer',            canse => 'chance/random',   cupri => 'copper',
    curdi => 'insure',          sirna => 'certain/sure',    snalu => 'swallow',
    soske => 'suspect',         tulpi => 'tulip',
);
for my $e (@l1) {
    next if $prims{ $e->[0] };
    die "no short gloss for Loglan 1 orphan $e->[0]\n" unless $orphan_gloss{ $e->[0] };
}

# ---- Drill files ----
# A list that is a symlink is somebody's own copy, kept elsewhere; it is
# replaced only on request.
sub out_file ($name) {
    my $file = "$dir/$name";
    if (-l $file && !$opt{'replace-links'}) {
        warn "$file is a symlink (to ${\ readlink $file}); left alone -- use --replace-links\n";
        return undef;
    }
    unlink $file if -l $file;
    return $file;
}

# Writes the list with its .added entries merged in, and returns what it wrote.
sub write_drill ($name, $rows) {
    $rows = merge_added($name, $rows);
    my $file = out_file($name) // return $rows;
    open my $fh, '>', $file or die "open $file: $!";
    print $fh "$_\n" for @$rows;
    close $fh;
    say "$name: ", scalar(@$rows), " items";
    return $rows;
}

# Current affix and gloss from PRIMS where the word survives; book definition as notes.
my @l1_rows = map {
    my $w = $_;
    my $p = $prims{$w};
    my $b = $l1{$w};
    join "\t", $w,
        ($p ? $p->{affix} : $b->[1]),
        ($p ? $p->{gloss} : $orphan_gloss{$w}),
        ($b ? "L1: $b->[2]" : $p->{notes});
} @l1_text;
write_drill('l1prims', \@l1_rows);

# A one-word origin names another entry, so chase it to the word that came
# first: ladza -> ladzo, bercu -> berci, bao -> ba(ks)o -> bakso.  Parentheses
# mark the letters an affix drops.  A couple of pairs point at each other
# (snola <-> soa), hence the seen-check.
sub first_word ($w) {
    my %seen = ($w => 1);
    my $cur  = $w;
    while (defined(my $next = pointer($origin{$cur}))) {
        last if $seen{$next}++;
        $cur = $next;
    }
    return $cur;
}

sub pointer ($text) {
    return undef unless defined $text;
    (my $w = $text) =~ s/[()]//g;
    return $w =~ /^[a-z]+$/ && $headword{$w} ? $w : undef;
}

# <word> <word it came from, or '-'> <what that word was built on, or '-'>
my @deriv_rows;
for my $w (@dict_order) {
    my $base = first_word($w);
    # An origin still pointing somewhere is one we could not chase (a cycle,
    # or a word the dictionary dropped); the word name is all we can show.
    my $from = pointer($origin{$base}) ? '-' : $origin{$base} // '-';
    push @deriv_rows, join "\t", $w, ($base eq $w ? '-' : $base), $from;
}

# The dictionary lists only one member of a couple of the declension sets --
# bifci for the bees, kurma for the worms -- so fill the rest of each set in
# from the member it does carry, as long as they agree on the word that came
# first.
for my $st (sort(keys %ethnic_stem), sort(keys %animal_stem)) {
    my @set  = grep { $prims{$_} || $dict{$_} } map { "$st$_" } qw(a e i o u);
    my @miss = grep { !$origin{$_} } @set;
    my %first = map { first_word($_) => 1 } grep { $origin{$_} } @set;
    next unless @miss && 1 == keys %first;
    my ($base) = keys %first;
    push @deriv_rows, map { join "\t", $_, $base, $origin{$base} } @miss;
}

write_drill('derivs', \@deriv_rows);

# ---- Cheat sheet ----
sub h ($s) { $s =~ s/&/&amp;/gr =~ s/</&lt;/gr =~ s/>/&gt;/gr }

# Only the marks a declension table actually uses get explained under it.
sub marks_note ($html) {
    my $note = join ' &nbsp;
', grep { defined } (
        $html =~ /&dagger;/   ? '&dagger; in <i>Loglan 1</i> only, not in the current PRIMS list.' : undef,
        $html =~ /&Dagger;/   ? '&Dagger; in the dictionary only: borrowings, later coinages, and words the PRIMS list does not carry.' : undef,
        $html =~ /class=rule/ ? '<span class=rule>*</span> in none of the sources; formed by rule.' : undef,
    );
    return length $note ? "<p class=note>$note</p>" : '';
}

# First alternative of a PRIMS gloss that is not just the rule-derived form
# (female-X, male-X, baby-X, X-like) the declension table already implies.
sub notable ($gloss) {
    for my $alt (split m{/}, $gloss) {
        $alt =~ s/^\s+|\s+$//g;
        # Parentheses mark letters the answer may leave out, so a rule-derived
        # form can hide inside them: "(female-)panda" is female-panda, and
        # "(house)-fly" is house-fly.  Test the alternative opened out.
        (my $bare = $alt) =~ s/[()]//g;
        next if $bare =~ /^(female|male|baby|immature|infant)[- ]/i;
        next if $bare =~ /[-_ ]?like$/i;
        return $alt =~ s/\(([^)]*)\)-?//gr;      # what is left of "(house)-fly" is "fly"
    }
    return '';
}

my $ethnic_html = '';
for my $st (sort keys %ethnic_stem) {
    my @cells;
    for my $v (qw(a e i o)) {
        my $w = "$st$v";
        if    ($prims{$w}) { push @cells, "<td><b>$w</b></td>" }
        elsif ($l1{$w})    { push @cells, "<td><b>$w</b><sup>&dagger;</sup></td>" }
        elsif ($dict{$w})  { push @cells, "<td><b>$w</b><sup>&Dagger;</sup></td>" }
        else               { push @cells, "<td class=rule>$w<sup>*</sup></td>" }
    }
    # The row is headed by the names in the language word's gloss -- the one
    # in "X-language" first, then the rest: "Arabic-language/Arab/Arabic" is
    # "Arabic / Arab" -- else by the stem.
    my ($aux_a) = grep { /^\Q$st\Ea\t/ } @{ $aux{ethnic} // [] };
    my @alt = split m{/}, (split /\t/, $aux_a // '')[2] // '';
    my ($lang) = map { /^(.+)-language\z/ ? $1 : () } @alt;
    my %seen;
    my @names = grep { !$seen{ gloss_key($_) }++ }
                 grep { length } $lang // (), grep { !/-language\z/ } @alt;
    $ethnic_html .= "<tr><th>" . h(@names ? join(' / ', @names) : $st)
                  . "</th>@cells</tr>\n";
}

my $ethnic_note = marks_note($ethnic_html);

my $animal_html = '';
for my $st (sort keys %animal_stem) {
    my $u     = $animal_word{"${st}u"};
    my $label = notable($u->{gloss});
    my $affix = $u->{affix};
    my @cells;
    for my $v (qw(u a o i e)) {
        my $w = "$st$v";
        my $e = $animal_word{$w};
        push(@cells, "<td class=rule>$w<sup>*</sup></td>"), next unless $e;
        my $n = $v eq 'u' ? '' : notable($e->{gloss});
        $n = '' if gloss_key($n) eq gloss_key($label);   # the row header says it already
        push @cells, "<td><b>$w</b>" . ($e->{dict} ? '<sup>&Dagger;</sup>' : '')
                   . ($n ? " <span class=en>$n</span>" : '') . "</td>";
    }
    $animal_html .= "<tr><th>$label" . ($affix ne '-' ? " <span class=affix>($affix)</span>" : '') . "</th>@cells</tr>\n";
}
my $animal_note = marks_note($animal_html);

my $l1_html = '';
for my $w (@l1_text) {
    my $p = $prims{$w};
    my $b = $l1{$w};
    my $affix = $p ? $p->{affix} : $b->[1];
    my $def   = $b ? $b->[2] : "$p->{gloss}: $p->{notes}";
    # Animal-declension words changed meaning in 1991; show the current gloss too.
    my $now   = ($b && $p && $animal_stem{ substr $w, 0, 4 } && $w !~ /u$/)
              ? " <span class=en>[now: " . h($p->{gloss}) . "]</span>" : '';
    my $mark  = $p ? '' : '<sup>&dagger;</sup>';
    my $aff   = $affix eq '-' ? '' : " <span class=affix>($affix)</span>";
    $l1_html .= "<div class=p><b>$w</b>$mark$aff " . h($def) . "$now</div>\n";
}
my $orphan_note = join ', ', map {
    "<b>$_</b>" . ($replaced{$_} ? " &rarr; $replaced{$_}" : '')
} grep { !$prims{$_} } @l1_text;

my $n_l1 = @l1_text;
my $n_eth = keys %ethnic_stem;
my $n_ani = keys %animal_stem;

# It was cheatsheet.html once; the old one, built here, would only mislead.
unlink "$dir/cheatsheet.html" if -f "$dir/cheatsheet.html" && !-l "$dir/cheatsheet.html";
my $sheet = out_file('vocab-cheatsheet.html') // exit 0;
open my $out, '>', $sheet or die "open $sheet: $!";
print $out <<"HTML";
<html><head><title>Loglan Vocabulary Cheat Sheet</title>
<meta charset="utf-8">
<style type="text/css">
  body   { font-family: sans-serif; font-size: 11pt; max-width: 75em; margin: 1em auto; padding: 0 1em; }
  h1, h2 { border-bottom: 1px solid #999; }
  table  { border-collapse: collapse; margin-bottom: 1em; }
  th, td { text-align: left; padding: 0.15em 0.9em 0.15em 0; vertical-align: top; white-space: nowrap; }
  th     { font-weight: bold; }
  thead th { border-bottom: 1px solid #999; }
  td.rule  { color: #3333FF; }
  span.en    { color: #444; }
  span.affix { color: #777; font-size: 90%; }
  .prims   { columns: 3 22em; column-gap: 1.5em; font-size: 10pt; }
  .p       { break-inside: avoid; padding-left: 1.2em; text-indent: -1.2em; margin-bottom: 0.1em; }
  p.note   { font-size: 90%; color: #444; }
  \@media print { body { font-size: 9pt; max-width: none; } .prims { columns: 4 16em; font-size: 8pt; } h2 { page-break-before: always; } }
</style>
</head>
<body>
<h1>Loglan Vocabulary Cheat Sheet</h1>
<p class=note>Ethnic and animal words are taken from the Institute PRIMS file and the
Loglan-to-English dictionary; the primitive list is
every primitive used in the main text of <i>Loglan 1</i>. Regenerate with <tt>loglan-update</tt>. Matching drill files for
<tt>loglan-teach</tt>: <tt>ethnic</tt>, <tt>animals</tt>, <tt>l1prims</tt>, plus <tt>derivs</tt>, the word-origin
table it shows after each answer.</p>
<p class=note>The Loglan words and definitions here are drawn from Loglan material: all rights reserved
by The Loglan Center, Inc. (the Idaho corporation which has superseded the Florida corporation);
used with its permission.</p>

<h2>Ethnic declension ($n_eth stems)</h2>
<table>
  <tr><td><b>-a</b></td><td>the language</td><td class=rule><i>is part of the X language</i></td></tr>
  <tr><td><b>-e</b></td><td>the territory / district</td><td class=rule><i>is a place where Xs live</i> (added by the Academy, SLK 91/1)</td></tr>
  <tr><td><b>-i</b></td><td>the person</td><td class=rule><i>is an X person</i></td></tr>
  <tr><td><b>-o</b></td><td>the culture</td><td class=rule><i>is part of X culture</i></td></tr>
</table>
<table>
<thead><tr><th></th><th>-a language</th><th>-e territory</th><th>-i person</th><th>-o culture</th></tr></thead>
$ethnic_html</table>
$ethnic_note

<h2>Animal declension ($n_ani stems)</h2>
<table>
  <tr><td><b>-u</b></td><td>generic, any age or sex</td></tr>
  <tr><td><b>-a</b></td><td>female</td></tr>
  <tr><td><b>-o</b></td><td>male</td></tr>
  <tr><td><b>-i</b></td><td>infant / juvenile</td></tr>
  <tr><td><b>-e</b></td><td>like that species (adjectival: <i>is more X-like than..</i>)</td></tr>
</table>
<p class=note>Adopted by the Academy in SLK 91/3. CVC affixes assigned to the old word stay with the generic
<b>-u</b> form (<i>horkarti</i> = horse cart). English is shown only where a special word exists
(ewe, ram, lamb); otherwise read it off the ending.</p>
<table>
<thead><tr><th>animal</th><th>-u generic</th><th>-a female</th><th>-o male</th><th>-i young</th><th>-e -like</th></tr></thead>
